# ───────── Core ─────────
# Supabase project shared by every module (chats, WhatsApp leads, call leads, campaigns, users).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
# Random string that signs sign-in sessions (openssl rand -hex 32). Changing it signs everyone out.
SESSION_SECRET=
# Encrypts each client workspace's saved API keys (openssl rand -hex 32). Defaults to one derived from
# SESSION_SECRET; set it explicitly so you can rotate SESSION_SECRET without losing saved keys.
CREDENTIALS_KEY=
# Public sign-up at /signup (new workspaces wait for approval in the Admin console). Set to false for invite-only.
# SIGNUP_ENABLED=true
# Optional emergency login used only if the app_users table is missing or unreachable.
# BOOTSTRAP_USERNAME=
# BOOTSTRAP_PASSWORD=

# ───────── AI (both modules): Google Gemini ─────────
# Lead scoring, WhatsApp AI replies/drafts and call lead briefs. Google AI Studio → Get API key.
GEMINI_API_KEY=
# Model for scoring and call briefs (default gemini-3.5-flash). WhatsApp replies pick their model on the Agent page.
# GEMINI_MODEL=gemini-3.5-flash

# ───────── WhatsApp (Twilio) ─────────
# These are the PRIMARY workspace's keys. Other client workspaces save theirs in Workspace settings → Connections.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
# Public URL of this app (ngrok locally, your domain in production). Must match the Twilio webhook URL.
PUBLIC_BASE_URL=
# Optional: your n8n WhatsApp workflow webhook
N8N_WEBHOOK_URL=

# ───────── Voice calls (Retell AI) ─────────
# Primary workspace only; other workspaces save their Retell key in Workspace settings → Connections.
RETELL_API_KEY=
RETELL_SECRET_KEY=
# Optional: limit the Calls module to specific agents (comma-separated agent IDs)
ALLOWED_AGENT_IDS=

